 "poems": [
  {
   "seq": "1",
   "text": "櫻ちろ木の下風は寒からて空にしられぬ雪そ降ける",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "我宿の花みかてらに來る人はちりなん後そこひしかるへき",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "いまこんといひし計に長月の有明の月を待出るかな",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "ちりちらすきかまほしきを古〓の花みて歸る人もあはなん",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "世中に絕て櫻のなかりせは春の心はのとけからまし",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "末の露もとの雫や世中のをくれさきたつためしなるらん",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "春たつといふはかりにやみよしのゝ山も霞て今朝はみゆらん",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "千年ましかきれる松もけふよりは君にひかれて萬代やへん",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "行やらて山路暮しつ郭公今一聲のきかまほしさに",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "さ夜更てね覺さりせは郭公人傳に社きくへかりけれ",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "人の親の心はやみにあらね共子を思ふみちにまよひぬる哉",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "あふ〓との絕てしなくは中〓〓に人をも身をもうらみさらまし",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "夕されはさほのかはらの河風に友まとはして干鳥鳴え",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "天津風ふけ井の浦にゐる田鶴のなとか雲ゐにかへらさるへき",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "色みえてうつろふ物は世中の人の心の花にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "秋の野の萩のにしきを我やとに鹿の音なからうつしてし哉",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "みよしのゝ山の白雪つもるらし古さと寒く成まさるん",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "年每に春のわかれをあはれとも人にをくるゝ人そしりける",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "有明の月の光をまつほとにわかよのいたくふけにける哉",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "またしらぬ古里人はけふまてにこんとたのめし我を待らん",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "琴の音に峯の松風かよふらしいつれのをよりしらへそめけん",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "岩はしの夜の契りも絕ぬへしあくるわひしきかつらきの神",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "歎きつゝ獨ぬるよのあくるまはいかに久しき物とかはしる",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "わすれしの行末まてはかたけれとけふを限りの命とも哉",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "やかすとも草はもえなん春日野をたゝ春の日に任せたらなん",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "水の面にてる月なみをかそふれはこよひそ秋の最中成ける",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "かそふれは我身につもる年月ををくりむかふと何いそくらん",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "うくひすの聲なかりせは雪きえぬ山里いかて春をしらまし",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "ほの〓〓とあかしの浦の朝霧に島かくれ行舟をしそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "和歌の浦に汐みちくれはかたをなみ蘆へをさして田鶴鳴渡る",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
